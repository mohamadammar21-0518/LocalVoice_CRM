NODE_ENV=production
PORT=3000
HOST=0.0.0.0
APP_ORIGIN=http://localhost:3000
JWT_SECRET=replace-with-at-least-32-random-characters
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=replace-with-at-least-12-characters
DATABASE_URL=mysql://localvoice:change-this-password@mysql:3306/localvoice
MYSQL_PASSWORD=change-this-password
MYSQL_ROOT_PASSWORD=change-this-root-password
VOICE_SERVICE_TOKEN=replace-with-a-long-random-service-token
WHISPER_SERVER_URL=http://speech:8001
TTS_SERVER_URL=http://tts:8002
WHISPER_MODE=fastapi
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1
TTS_MODE=server
APP_TIMEZONE=Asia/Kuala_Lumpur
