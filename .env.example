# Never commit your real .env. Generate a JWT secret with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
DATABASE_URL=mysql://lvcrmuser:CHANGE_THIS@127.0.0.1:3306/localvoice
JWT_SECRET=
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=
SESSION_HOURS=8
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
APP_TIMEZONE=Asia/Kuala_Lumpur
TRUST_PROXY=0

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b
OLLAMA_KEEP_ALIVE=30m
LLM_MAX_TOKENS=700
LLM_TIMEOUT_MS=60000
LLM_CONCURRENCY=1
VOICE_QUEUE_LIMIT=8
VOICE_QUEUE_TIMEOUT_MS=15000

WHISPER_MODE=fastapi
WHISPER_SERVER_URL=http://127.0.0.1:8001
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=1
WHISPER_CPU_THREADS=4
WHISPER_PORT=8001
FFMPEG_PATH=ffmpeg
VOICE_SERVICE_HOST=127.0.0.1
VOICE_SERVICE_TOKEN=

TTS_MODE=server
TTS_SERVER_URL=http://127.0.0.1:8002
TTS_PORT=8002
PIPER_VOICE=C:\piper\voices\en_US-lessac-medium.onnx
# Optional CLI compatibility, which loads the voice per request:
PIPER_PATH=C:\piper\piper.exe
LOCAL_STORAGE_PATH=./uploads
AUDIO_RETENTION_DAYS=30

# Administrators may import/read/sync through this optional account-wide token.
# Placeholder: REPLACE_WITH_HUBSPOT_PRIVATE_APP_TOKEN (leave blank until connected).
HUBSPOT_ACCESS_TOKEN=
# OAuth login for each user's own HubSpot account. Private tokens cannot do login.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_OAUTH_SCOPES=oauth crm.objects.contacts.read crm.objects.contacts.write
HUBSPOT_OAUTH_OPTIONAL_SCOPES=
# Base64 32-byte key. Falls back to SALESFORCE_TOKEN_ENCRYPTION_KEY if configured.
HUBSPOT_TOKEN_ENCRYPTION_KEY=
HUBSPOT_TIMEOUT_MS=15000

# Store this key separately from your backup artifacts.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BACKUP_ENCRYPTION_KEY=
MYSQLDUMP_PATH=mysqldump
MYSQL_PATH=mysql
# RESTORE_DATABASE_URL points only at a separate empty recovery-test database.
RESTORE_DATABASE_URL=

# Windows local virtual environment; set an absolute path for a service manager.
PYTHON_PATH=./.venv/Scripts/python.exe

# Salesforce Developer Edition: your org’s My Domain URL and External Client App.
# Placeholders: https://REPLACE_WITH_MY_DOMAIN.my.salesforce.com,
# REPLACE_WITH_SALESFORCE_CLIENT_ID, REPLACE_WITH_SALESFORCE_CLIENT_SECRET.
# Keep these blank until activation. Callback: http://localhost:3000/api/salesforce/callback
SALESFORCE_LOGIN_URL=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_API_VERSION=64.0
# Optional persistent OAuth storage for a single Node instance. Generate once:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep this key in your secret store; changing it requires reconnecting Salesforce.
SALESFORCE_TOKEN_ENCRYPTION_KEY=

# Local English streaming dictation (download the model from the official Vosk model list).
VOSK_MODEL_PATH=models/vosk-model-small-en-us-0.15

# CRM Studio external connections: assign server credentials to one workspace ID.
# Placeholders: REPLACE_WITH_TWENTY_API_KEY and REPLACE_WITH_STUDIO_WORKSPACE_UUID.
# Workspace IDs below identify the LocalVoice workspace, not the provider workspace.
TWENTY_API_URL=http://localhost:3001
TWENTY_API_KEY=
TWENTY_WORKSPACE_ID=
HUBSPOT_STUDIO_WORKSPACE_ID=
# Fine-tuned candidates are evaluated before changing OLLAMA_MODEL or WHISPER_MODEL_SIZE.
# WHISPER_MODEL_SIZE also accepts a local CTranslate2 model directory.
