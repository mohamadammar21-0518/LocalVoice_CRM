{
  "name": "localvoice-crm",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch server/_core/index.ts",
    "build": "cross-env NODE_ENV=production vite build && cross-env NODE_ENV=production esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:client": "vitest run --config vitest.client.config.ts",
    "db:push": "tsx scripts/migrate.ts --apply",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "backup": "tsx scripts/backup.ts backup",
    "backup:verify": "tsx scripts/backup.ts verify",
    "backup:restore": "tsx scripts/backup.ts restore",
    "retention": "tsx scripts/retention.ts",
    "voice:evaluate": "tsx scripts/evaluate.ts",
    "studio:evaluate": "tsx scripts/evaluate-studio.ts",
    "training:export": "tsx scripts/export-training.ts",
    "pm2:start": "pm2 start ecosystem.config.cjs"
  },
